{
  "entities": {
    "Session": {
      "title": "Session",
      "description": "A live event or presentation room for real-time audience Q&A",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "code": {
          "type": "string",
          "maxLength": 10
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "hostUid": {
          "type": "string",
          "maxLength": 128
        },
        "hostName": {
          "type": "string",
          "maxLength": 100
        },
        "isActive": {
          "type": "boolean"
        },
        "allowAnonymous": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "code",
        "hostUid",
        "isActive",
        "createdAt"
      ]
    },
    "Question": {
      "title": "Question",
      "description": "An audience-submitted question inside a session",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 500
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "maxLength": 100
        },
        "isAnonymous": {
          "type": "boolean"
        },
        "upvotes": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "answered",
            "hidden"
          ]
        },
        "answerText": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "text",
        "authorUid",
        "authorName",
        "status",
        "upvotes",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/Session"
      },
      "description": "Live Q&A event sessions"
    },
    "/sessions/{sessionId}/questions/{questionId}": {
      "schema": {
        "$ref": "#/entities/Question"
      },
      "description": "Audience questions for a session"
    }
  }
}