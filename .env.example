# Platform Gemini key (server-side). Used for Free Single Keynote sessions,
# document OCR, and Multi-Speaker Series when the host leaves their key blank.
GEMINI_API_KEY=

# Required for real Firebase Auth (email + Google). Synced into
# public/firebase-runtime-config.js for ng serve; Cloud Run injects via Secret Manager.
# Get it from Firebase Console → Project settings → Your apps → Web → apiKey
FIREBASE_API_KEY=
